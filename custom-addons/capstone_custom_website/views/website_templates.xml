<odoo>
    <template id="homepage" name="Capstone Bath Fittings Homepage">
        <t t-call="website.layout">
            <main id="wrap" class="capstone-homepage">
                <section class="capstone-hero">
                    <div class="capstone-hero__orb capstone-hero__orb--one"/>
                    <div class="capstone-hero__orb capstone-hero__orb--two"/>
                    <div class="container capstone-hero__content">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-7">
                                <p class="capstone-eyebrow"><span/> Bath fittings &amp; accessories</p>
                                <h1>Designed for everyday comfort. Built to last.</h1>
                                <p class="capstone-hero__lead">Capstone brings thoughtful design, dependable quality and an elegant finish to bathrooms, homes and projects of every scale.</p>
                                <div class="capstone-actions">
                                    <a href="#catalogue" class="capstone-btn capstone-btn--primary">Explore the collection <i class="fa fa-arrow-right"/></a>
                                    <a href="/contactus" class="capstone-btn capstone-btn--light">Talk to our team</a>
                                </div>
                                <div class="capstone-trust-row" aria-label="Capstone commitments">
                                    <span><i class="fa fa-check-circle"/> Quality-led</span>
                                    <span><i class="fa fa-check-circle"/> Water conscious</span>
                                    <span><i class="fa fa-check-circle"/> Service backed</span>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="capstone-hero__product-card">
                                    <img src="/capstone_custom_website/static/src/img/img_1.jpg" alt="Capstone bath fittings collection"/>
                                    <div class="capstone-hero__product-label">
                                        <span>Since our first fitting</span>
                                        <strong>Experience comfort</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="capstone-intro section-space">
                    <div class="container">
                        <div class="row g-5 align-items-center">
                            <div class="col-lg-5">
                                <div class="capstone-intro__visual">
                                    <div class="capstone-intro__accent"/>
                                    <img src="/capstone_custom_website/static/src/img/img_1.jpg" alt="Capstone bath fittings" loading="lazy"/>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <p class="capstone-eyebrow capstone-eyebrow--dark"><span/> The Capstone way</p>
                                <h2 class="capstone-heading">Beautifully considered fittings for the way people live.</h2>
                                <div class="capstone-copy">
                                    <p>Capstone develops innovative bathroom fittings and accessories that help people live healthy, responsibly and beautifully.</p>
                                    <p>We help customers redefine their lifestyle with elegant bath fittings at a moderate price, without compromising on quality. Every product is made with durability, dependable performance and a comprehensive warranty in mind.</p>
                                    <p>By listening closely to what consumers need and investing in research, design and smart technology, we create solutions that make everyday life easier.</p>
                                </div>
                                <a href="/contactus" class="capstone-text-link">Build your next project with Capstone <i class="fa fa-arrow-right"/></a>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="capstone-values section-space">
                    <div class="container">
                        <div class="capstone-section-header">
                            <div>
                                <p class="capstone-eyebrow capstone-eyebrow--dark"><span/> Why Capstone</p>
                                <h2 class="capstone-heading">Made for a better daily ritual.</h2>
                            </div>
                            <p>Practical engineering and considered design come together in every collection.</p>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4"><article class="capstone-value-card"><span class="capstone-icon"><i class="fa fa-star"/></span><h3>Premium quality</h3><p>Chrome and nickel finishes engineered for everyday durability, lasting appeal and a refined touch.</p></article></div>
                            <div class="col-md-4"><article class="capstone-value-card"><span class="capstone-icon"><i class="fa fa-tint"/></span><h3>Water efficient</h3><p>Eco flow regulators support thoughtful water management without sacrificing comfort or performance.</p></article></div>
                            <div class="col-md-4"><article class="capstone-value-card"><span class="capstone-icon"><i class="fa fa-shield"/></span><h3>Service backed</h3><p>Reliable support and warranty coverage provide confidence long after installation.</p></article></div>
                        </div>
                    </div>
                </section>

                <section id="catalogue" class="capstone-catalogue section-space">
                    <div class="container">
                        <div class="capstone-section-header capstone-section-header--catalogue">
                            <div>
                                <p class="capstone-eyebrow capstone-eyebrow--dark"><span/> Browse the range</p>
                                <h2 class="capstone-heading">Find the right finish for every space.</h2>
                            </div>
                            <p>Explore the Capstone products currently available on our website, organised by category.</p>
                        </div>

                        <nav t-if="category_products" class="capstone-category-nav" aria-label="Product categories">
                            <t t-foreach="category_products" t-as="cat_prod">
                                <a t-attf-href="#category-#{cat_prod['category'].id}" t-esc="cat_prod['category'].name"/>
                            </t>
                        </nav>

                        <t t-if="category_products">
                            <t t-foreach="category_products" t-as="cat_prod">
                                <section t-attf-id="category-#{cat_prod['category'].id}" class="capstone-category-section">
                                    <div class="capstone-category-heading">
                                        <div>
                                            <p>Capstone collection</p>
                                            <h3 t-field="cat_prod['category'].name"/>
                                        </div>
                                        <span t-esc="'%s products' % len(cat_prod['products'])"/>
                                    </div>
                                    <div class="capstone-product-grid">
                                        <t t-foreach="cat_prod['products']" t-as="product">
                                            <article class="capstone-product-card">
                                                <a t-att-href="product.website_url" class="capstone-product-card__image" t-att-title="product.name">
                                                    <t t-if="product.image_1920">
                                                        <img t-att-src="'/web/image/product.template/%s/image_1920' % product.id" t-att-alt="product.name" loading="lazy"/>
                                                    </t>
                                                    <t t-else="">
                                                        <img src="/capstone_custom_website/static/src/img/img_1.jpg" t-att-alt="'%s catalogue placeholder' % product.name" loading="lazy"/>
                                                    </t>
                                                </a>
                                                <div class="capstone-product-card__body">
                                                    <p t-field="cat_prod['category'].name"/>
                                                    <h4><a t-att-href="product.website_url" t-field="product.name"/></h4>
                                                    <a t-att-href="product.website_url" class="capstone-product-card__link">View product <i class="fa fa-arrow-right"/></a>
                                                </div>
                                            </article>
                                        </t>
                                    </div>
                                </section>
                            </t>
                        </t>
                        <div t-else="" class="capstone-empty-catalogue">
                            <i class="fa fa-th-large"/>
                            <h3>Our catalogue is being refreshed.</h3>
                            <p>Please check back soon, or contact our team to discuss the range you need.</p>
                            <a href="/contactus" class="capstone-btn capstone-btn--primary">Contact us</a>
                        </div>
                    </div>
                </section>

                <section class="capstone-brochures section-space">
                    <div class="container">
                        <div class="capstone-section-header">
                            <div>
                                <p class="capstone-eyebrow capstone-eyebrow--dark"><span/> Our brochure collection</p>
                                <h2 class="capstone-heading">A closer look at our range.</h2>
                            </div>
                            <p>Explore our premium product collections, finishes and warranty information.</p>
                        </div>
                        <div class="capstone-brochure-grid">
                            <figure><img src="/capstone_custom_website/static/src/img/b1.jpg" alt="Capstone anniversary brochure" loading="lazy"/><figcaption>Anniversary edition</figcaption></figure>
                            <figure><img src="/capstone_custom_website/static/src/img/b2.jpg" alt="Capstone product range brochure" loading="lazy"/><figcaption>Product range</figcaption></figure>
                            <figure><img src="/capstone_custom_website/static/src/img/b3.jpg" alt="Capstone warranty brochure" loading="lazy"/><figcaption>Warranty information</figcaption></figure>
                            <figure><img src="/capstone_custom_website/static/src/img/b4.jpg" alt="Capstone colour options brochure" loading="lazy"/><figcaption>Colour options</figcaption></figure>
                        </div>
                    </div>
                </section>

                <section class="capstone-contact section-space">
                    <div class="container">
                        <div class="capstone-contact__card">
                            <div>
                                <p class="capstone-eyebrow"><span/> Let’s talk</p>
                                <h2>Looking for something custom?</h2>
                                <p>Speak with our sales team for personalised fittings, project support and bulk orders.</p>
                            </div>
                            <div class="capstone-actions">
                                <a href="/contactus" class="capstone-btn capstone-btn--primary"><i class="fa fa-envelope"/> Contact us</a>
                                <a href="/complaint/register" class="capstone-btn capstone-btn--outline"><i class="fa fa-life-ring"/> Register a complaint</a>
                            </div>
                        </div>
                    </div>
                </section>
            </main>
        </t>
    </template>
</odoo>
