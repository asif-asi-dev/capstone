                <style>
                    /* About Section Improvements */
                    .about-row {
                    min-height: 600px; /* Set a minimum height for equal sizing */
                    }

                    .about-carousel-col,
                    .about-content-col {
                    min-height: 600px; /* Ensure both columns have the same minimum height */
                    }

                    .about-carousel {
                    border-radius: 15px;
                    overflow: hidden;
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
                    }

                    .carousel-image {
                    width: 100%;
                    height: 600px; /* Fixed height for carousel images */
                    object-fit: cover;
                    object-position: center;
                    }

                    .about-content {
                    padding: 40px;
                    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
                    border-radius: 15px;
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
                    }

                    .content-wrapper {
                    max-width: 100%;
                    }

                    .about-content p {
                    font-size: 16px;
                    line-height: 1.7;
                    color: #555;
                    margin-bottom: 20px;
                    text-align: justify;
                    }

                    .about-content p:last-child {
                    margin-bottom: 0;
                    }

                    .carousel-overlay {
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: rgba(0, 0, 0, 0.4);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    opacity: 0;
                    transition: opacity 0.3s ease;
                    }

                    .carousel-item:hover .carousel-overlay {
                    opacity: 1;
                    }

                    .overlay-content {
                    text-align: center;
                    color: white;
                    }

                    .overlay-content i {
                    font-size: 3rem;
                    margin-bottom: 15px;
                    color: #007bff;
                    }

                    .overlay-content h3 {
                    font-size: 1.8rem;
                    font-weight: 600;
                    margin-bottom: 10px;
                    }

                    .overlay-content p {
                    font-size: 1.1rem;
                    margin: 0;
                    opacity: 0.9;
                    }

                    /* Responsive adjustments */
                    @media (max-width: 991.98px) {
                    .about-row {
                    min-height: auto;
                    }

                    .about-carousel-col,
                    .about-content-col {
                    min-height: auto;
                    }

                    .carousel-image {
                    height: 400px;
                    }

                    .about-content {
                    padding: 30px;
                    margin-top: 30px;
                    }
                    }

                    @media (max-width: 767.98px) {
                    .carousel-image {
                    height: 300px;
                    }

                    .about-content {
                    padding: 20px;
                    }

                    .about-content p {
                    font-size: 15px;
                    }
                    }
