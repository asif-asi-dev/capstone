<!-- views/fsm_route_views.xml -->
<odoo>
    <record id="view_fsm_route_assignment_form" model="ir.ui.view">
        <field name="name">fsm.route.assignment.form</field>
        <field name="model">fsm.route.assignment</field>
        <field name="arch" type="xml">
            <form string="Route Assignment">
                <header>
                     <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <field name="route_id" readonly="state != 'draft'"/>
                        <field name="sales_partner_id" readonly="state != 'draft'"/>
                        <field name="week_day_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                        <field name="shop_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fsm_route_assignment_tree" model="ir.ui.view">
        <field name="name">fsm.route.tree</field>
        <field name="model">fsm.route.assignment</field>
        <field name="arch" type="xml">
            <tree string="Routes Assignment">
                <field name="route_id"/>
                <field name="sales_partner_id"/>
                <field name="shop_ids" widget="many2many_tags"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_fsm_route_assignment" model="ir.actions.act_window">
        <field name="name">Routes Assignment</field>
        <field name="res_model">fsm.route.assignment</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
