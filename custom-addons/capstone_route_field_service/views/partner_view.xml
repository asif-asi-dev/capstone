<odoo>
    <record id="view_partner_form_inherit_fsm_visit" model="ir.ui.view">
        <field name="name">partner.form.inherit.fsm.visit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="route_id"/>
                <field name="distance_from_company" invisible="route_id == False"/>
                <field name="delivery_route_id"/>
            </field>
        </field>
    </record>
</odoo>
