<odoo>
    <record id="view_order_form_inherit_fsm_visit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.fsm.visit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insert after customer (partner_id) field -->
            <field name="payment_term_id" position="after">
                <field name="fsm_visit_id" readonly="1"/>
                <field name="route_id" readonly="1"/>
                <field name="delivery_route_id"/>
                <field name="shop_sequence"/>
            </field>
        </field>
    </record>

    <record id="view_order_tree_grouped_by_route" model="ir.ui.view">
        <field name="name">sale.order.tree.grouped.route</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_group_by">delivery_route_id</attribute>
                <attribute name="default_order">delivery_route_id, shop_sequence, id</attribute>
            </xpath>

            <!-- Add the delivery_route_id and shop_sequence fields to the tree if not already present -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="delivery_route_id" optional="show"/>
                <field name="shop_sequence" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
