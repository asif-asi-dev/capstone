<!-- views/fsm_route_views.xml -->
<odoo>
    <record id="view_fsm_route_form" model="ir.ui.view">
        <field name="name">fsm.route.form</field>
        <field name="model">fsm.route</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="area_id"/>
                        <field name="total_km"/>
                        <field name="shop_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fsm_route_tree" model="ir.ui.view">
        <field name="name">fsm.route.tree</field>
        <field name="model">fsm.route</field>
        <field name="arch" type="xml">
            <tree string="Routes">
                <field name="name"/>
                <field name="area_id"/>
                <field name="total_km"/>
            </tree>
        </field>
    </record>

    <record id="action_fsm_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">fsm.route</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
