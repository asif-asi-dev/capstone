<odoo>
    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">view.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="delivery_route_id" invisible="0"/>
                <field name="shop_sequence"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_tree_grouped_by_route" model="ir.ui.view">
        <field name="name">stock.picking.tree.grouped.route</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">delivery_route_id, shop_sequence, scheduled_date, id</attribute>
            </xpath>

            <!-- Add the delivery_route_id and shop_sequence fields to the tree -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="delivery_route_id" optional="show"/>
                <field name="shop_sequence" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_tree_grouped_by_route" model="ir.ui.view">
        <field name="name">stock.picking.tree.grouped.route</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_group_by">delivery_route_id</attribute>
                <attribute name="default_order">delivery_route_id, shop_sequence, id</attribute>
            </xpath>

            <!-- Add the delivery_route_id and shop_sequence fields to the tree if not already present -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="delivery_route_id" optional="show"/>
                <field name="shop_sequence" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="action_picking_store_user" model="ir.actions.act_window">
        <field name="name">Store Operations</field>
        <field name="res_model">stock.picking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="domain">
            [
            ('picking_type_code', '=', 'internal'),
            ('sale_id', '!=', False),
            ('state', '=', 'assigned')
            ]
        </field>
        <field name="context">{'default_picking_type_code': 'internal', 'contact_display': 'partner_address', 'create':
            0, 'edit': 0}
        </field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transfer found. Let's create one!
            </p>
        </field>
    </record>

    <record id="action_picking_delivery_boy" model="ir.actions.act_window">
        <field name="name">Delivery Operations</field>
        <field name="res_model">stock.picking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="domain">
            [
            ('picking_type_code', '=', 'outgoing'),
            ('state', 'in', ('waiting', 'assigned'))
            ]
        </field>
        <field name="context">{'default_picking_type_code': 'outgoing', 'contact_display': 'partner_address', 'create':
            0}
        </field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transfer found. Let's create one!
            </p>
        </field>
    </record>

    <record id="action_picking_replacement" model="ir.actions.act_window">
        <field name="name">Replacement Operations</field>
        <field name="res_model">stock.picking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="domain">
            [
            ('picking_type_code', '=', 'outgoing'),
            ('return_order_id', '!=', False),
            ('is_replacement', '!=', False),
            ]
        </field>
        <field name="context">
            {
            'default_picking_type_code': 'outgoing',
            'search_default_draft': 1,
            'create': 0
            }
        </field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
    </record>
</odoo>
