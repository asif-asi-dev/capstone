    <!-- Repair Orders: only those linked to his assignment; read/write (no create/unlink) -->
    <record id="repair_order_technician_rule_related_rw" model="ir.rule">
        <field name="name">Repair Order (Technician) — related to my assignments (read/write)</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="domain_force">[('assignment_id.technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('capstone_complaint_management.group_complaint_technician'))]"/>
        <field name="perm_read" eval="True"/>
