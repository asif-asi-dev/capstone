    <!-- =========================
         RECORD RULES — TECHNICIAN
         Only own assignments; related SRR (read); related Repairs (read/write)
    ========================== -->
    <!-- Assignments: only those where he is the technician -->
    <record id="complaint_assignment_technician_rule_mine" model="ir.rule">
        <field name="name">Assignment (Technician) — only assigned to me</field>
        <field name="model_id" ref="model_complaint_assignment"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('capstone_complaint_management.group_complaint_technician'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>   <!-- can update progress -->
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

