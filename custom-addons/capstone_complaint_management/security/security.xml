<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================
         GROUPS
    ========================== -->
    <record id="module_category_complaint_management" model="ir.module.category">
        <field name="name">Complaint Management</field>
        <field name="sequence">14</field>
    </record>

    <record id="group_complaint_technician" model="res.groups">
        <field name="name">Complaint Technician</field>
        <field name="category_id" ref="capstone_complaint_management.module_category_complaint_management"/>
    </record>
    <record id="group_complaint_admin" model="res.groups">
        <field name="name">Complaint Manager</field>
        <field name="category_id" ref="capstone_complaint_management.module_category_complaint_management"/>
       <field name="implied_ids" eval="[(4, ref('capstone_complaint_management.group_complaint_technician'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- =========================
         RECORD RULES — ADMIN
         Full access to all module models
    ========================== -->
    <!-- Complaint -->
    <record id="complaint_management_admin_rule_all" model="ir.rule">
        <field name="name">Complaint (Admin) — all records</field>
        <field name="model_id" ref="model_complaint_management"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('capstone_complaint_management.group_complaint_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Assignment -->
    <record id="complaint_assignment_admin_rule_all" model="ir.rule">
        <field name="name">Assignment (Admin) — all records</field>
        <field name="model_id" ref="model_complaint_assignment"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('capstone_complaint_management.group_complaint_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

