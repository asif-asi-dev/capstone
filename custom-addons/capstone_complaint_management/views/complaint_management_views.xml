<odoo>
    <record id="view_complaint_management_tree" model="ir.ui.view">
        <field name="name">complaint.management.tree</field>
        <field name="model">complaint.management</field>
        <field name="arch" type="xml">
            <tree string="Complaints" default_order="id desc">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="purchased_shop_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="assignment_ids" widget="many2many_tags" options="{'no_create': True}"
                       string="Assignments"/>
                <field name="repair_order_ids" widget="many2many_tags" options="{'no_create': True}"
                       string="Services"/>
                <field name="picking_ids" widget="many2many_tags" options="{'no_create': True}"
                       string="Return/Replacements"/>
            </tree>
        </field>
    </record>

    <record id="view_complaint_management_form" model="ir.ui.view">
        <field name="name">complaint.management.form</field>
        <field name="model">complaint.management</field>
        <field name="arch" type="xml">
            <form string="Complaint Management">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,in_progress,resolved,closed"/>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary" invisible="state != 'draft'"
                    />
                    <button name="action_open_feedback_wizard"
                            string="Update Feedback"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'resolved' or review_line_ids"
                    />


                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" invisible="not assignment_ids"
                                name="action_view_assignments"
                                class="oe_stat_button"
                                icon="fa-tasks">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                        <button name="action_view_pickings" type="object"
                                icon="fa-truck" class="oe_stat_button"
                                invisible="not picking_ids"
                        >
                            <field name="picking_count" widget="statinfo" string="Return/Replacement"/>
                        </button>

                        <button name="action_view_repairs" type="object"
                                icon="fa-wrench" class="oe_stat_button"
                                invisible="not repair_order_ids">
                            <field name="repair_count" widget="statinfo" string="Repairs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h2>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h2>
                    </div>
                    <!-- STATUSBAR -->
                    <group>
                        <group>
                            <field name="customer_id" required="1" readonly="state != 'draft'"/>
                            <field name="purchase_date" required="1" readonly="state != 'draft'"/>
                            <field name="complaint_type_ids" widget="many2many_tags" invisible="1"
                                   readonly="state != 'draft'"/>
                        </group>

                        <group>
                            <field name="purchased_shop_id" required="1" readonly="state != 'draft'"/>
                            <field name="date" required="1" readonly="state != 'draft'"/>
                            <field name="assignment_ids" invisible="1" readonly="state != 'draft'"/>
                            <field name="picking_ids" invisible="1"/>
                            <field name="repair_order_ids" invisible="1"/>
                            <field name="technician_id"/>
                            <field name="google_map_link" widget="url" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- NOTEBOOK START -->
                    <notebook>
                        <page string="Complaint Products">
                            <field name="product_line_ids" required="1" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="product_id" readonly="parent.state != 'draft'"/>
                                    <field name="quantity" readonly="parent.state != 'draft'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Complaint Description">
                            <group>
                                <field name="description"
                                       placeholder="Describe the issue as mentioned by the customer..."
                                       readonly="state != 'draft'"/>
                            </group>

                            <group string="Uploaded Images">
                                <div class="d-flex flex-wrap gap-3 mt-3">
                                    <field name="image_1" widget="image"
                                           class="oe_avatar"
                                           options="{'preview_image': 'image_1'}"
                                           style="width: 150px; height: 150px; object-fit: cover;"
                                           invisible="not image_1" readonly="state != 'draft'"
                                    />
                                    <field name="image_2" widget="image"
                                           class="oe_avatar"
                                           options="{'preview_image': 'image_2'}"
                                           style="width: 150px; height: 150px; object-fit: cover;"
                                           invisible="not image_2" readonly="state != 'draft'"
                                    />
                                </div>

                                <group readonly="state != 'draft'">
                                    <field name="image_1" widget="image" options="{'preview_image': 'image_1'}" readonly="state != 'draft'"/>
                                    <field name="image_2" widget="image" options="{'preview_image': 'image_2'}" readonly="state != 'draft'"/>

                                    <field name="video_filename" invisible="1"/>
                                    <field name="video_file"
                                           filename="video_filename"
                                           widget="binary"
                                           readonly="state != 'draft'"
                                           options="{'accepted_file_extensions': '.mp4,.avi,.mov,.wmv,.flv,.webm,.mkv,.m4v'}"
                                    />


                                    <!--&lt;!&ndash; Video Preview &ndash;&gt;-->
                                    <!--<widget name="html" readonly="1">-->
                                    <!--    <div t-if="record.video_file.raw_value">-->
                                    <!--        <video width="320" height="240" controls>-->
                                    <!--            <source t-att-src="'data:video/mp4;base64,' + record.video_file.raw_value" type="video/mp4"/>-->
                                    <!--            Your browser does not support the video tag.-->
                                    <!--        </video>-->
                                    <!--    </div>-->
                                    <!--</widget>-->
                                </group>
                            </group>
                        </page>

                        <page string="Reviews">
                            <field name="review_line_ids" readonly="1">
                                <tree>
                                    <field name="technician_id" readonly="1"/>
                                    <field name="rating" readonly="1"/>
                                    <field name="feedback" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <!-- NOTEBOOK END -->
                </sheet>

                <!-- CHATTER -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_complaint_management_search" model="ir.ui.view">
        <field name="name">complaint.management.search</field>
        <field name="model">complaint.management</field>
        <field name="arch" type="xml">
            <search string="Complaints">
                <!-- Main Combined Search -->
                <field name="name" string="Reference / Customer"
                       filter_domain="['|',('name','ilike',self),('customer_id','ilike',self)]"/>

                <!-- Search Panel -->
                <!--            <searchpanel>-->
                <!--                <field name="purchased_shop_id" icon="fa-store" enable_counters="1"/>-->
                <!--            </searchpanel>-->

                <!-- Specific Field Filters -->
                <field name="date"/>
                <field name="customer_id"/>
                <field name="product_line_ids" string="Product"
                       filter_domain="[('product_line_ids.product_id.name','ilike',self)]"/>
                <field name="assignment_ids" string="Assignment"
                       filter_domain="[('assignment_ids.name','ilike',self)]"/>
                <field name="repair_order_ids" string="Services"
                       filter_domain="[('repair_order_ids.name','ilike',self)]"/>
                <field name="picking_ids" string="Return or replacement"
                       filter_domain="[('picking_ids.name','ilike',self)]"/>
                <!-- State Filters -->
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="filter_resolved" string="Resolved" domain="[('state','=','resolved')]"/>
                <filter name="filter_closed" string="Closed" domain="[('state','=','closed')]"/>

                <!-- Group By -->
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" domain="[]" context="{'group_by':'customer_id'}"/>
                    <filter name="group_shop" string="Shop" domain="[]" context="{'group_by':'purchased_shop_id'}"/>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_complaint_management" model="ir.actions.act_window">
        <field name="name">Complaints</field>
        <field name="res_model">complaint.management</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
