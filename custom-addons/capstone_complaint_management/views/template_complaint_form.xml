<odoo>
   <template id="template_complaint_form" name="Complaint Form">
    <t t-call="website.layout">
        <!-- Font Awesome CDN -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
        <div class="container-fluid px-3 px-md-4 py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8 col-xl-6">
                    <!-- Header Section -->
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-lg mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-exclamation-triangle text-warning icon-fallback" style="font-size: 2rem;" data-fallback="⚠️"></i>
                        </div>
                        <h1 class="text-white fw-bold mb-2">Register Your Complaint</h1>
                        <p class="text-white-50 mb-0">We're here to help resolve your concerns quickly</p>
                    </div>

                    <!-- Main Form Card -->
                    <div class="card border-0 shadow-lg" style="border-radius: 20px; backdrop-filter: blur(10px);">
                        <div class="card-body p-4 p-md-5">
                            <form action="/complaint/submit" method="post" class="needs-validation" novalidate="true">
                                <div class="row g-4">
                                    <!-- Personal Information Section -->
                                    <div class="col-12">
                                        <h5 class="text-primary fw-bold mb-3 d-flex align-items-center">
                                            <i class="fas fa-user-circle me-2 icon-fallback" data-fallback="👤"></i>
                                            Personal Information
                                        </h5>
                                    </div>

                                    <!-- Name Field -->
                                    <div class="col-12 col-md-6">
                                        <div class="form-floating mb-3">
                                            <input type="text"
                                                   name="customer_name"
                                                   class="form-control border-0 shadow-sm"
                                                   id="customerName"
                                                   placeholder="Enter your name"
                                                   required="1"
                                                   style="border-radius: 15px; background: rgba(248, 249, 250, 0.8);"/>
                                            <label for="customerName" class="text-muted">
                                                <i class="fas fa-user me-2 icon-fallback" data-fallback="👤"></i>Your Name *
                                            </label>
                                            <div class="invalid-feedback">Please enter your name.</div>
                                        </div>
                                    </div>

                                    <!-- Email Field -->
                                    <div class="col-12 col-md-6">
                                        <div class="form-floating mb-3">
                                            <input type="email"
                                                   name="customer_email"
                                                   class="form-control border-0 shadow-sm"
                                                   id="customerEmail"
                                                   placeholder="you@example.com"
                                                   style="border-radius: 15px; background: rgba(248, 249, 250, 0.8);"/>
                                            <label for="customerEmail" class="text-muted">
                                                <i class="fas fa-envelope me-2 icon-fallback" data-fallback="✉️"></i>Email Address
                                            </label>
                                            <div class="invalid-feedback">Please enter a valid email.</div>
                                        </div>
                                    </div>

                                    <!-- Mobile Field -->
                                    <div class="col-12 col-md-6">
                                        <div class="form-floating mb-3">
                                            <input type="tel"
                                                   name="customer_phone"
                                                   class="form-control border-0 shadow-sm"
                                                   id="customerPhone"
                                                   placeholder="10-digit mobile"
                                                   pattern="[0-9]{10}"
                                                   style="border-radius: 15px; background: rgba(248, 249, 250, 0.8);"/>
                                            <label for="customerPhone" class="text-muted">
                                                <i class="fas fa-phone me-2 icon-fallback" data-fallback="📞"></i>Mobile Number
                                            </label>
                                            <div class="invalid-feedback">Please enter a valid 10-digit mobile number.</div>
                                        </div>
                                    </div>

                                    <!-- Shop Selection -->
                                    <div class="col-12 col-md-6">
                                        <div class="form-floating mb-3">
                                            <select name="shop_id"
                                                    class="form-select border-0 shadow-sm"
                                                    id="shopSelect"
                                                    required="1"
                                                    style="border-radius: 15px; background: rgba(248, 249, 250, 0.8);">
                                                <option value="" disabled="true" selected="true">Choose a shop...</option>
                                                <t t-foreach="shops" t-as="shop">
                                                    <option t-att-value="shop.id"><t t-esc="shop.name"/></option>
                                                </t>
                                            </select>
                                            <label for="shopSelect" class="text-muted">
                                                <i class="fas fa-store me-2 icon-fallback" data-fallback="🏪"></i>Purchased Shop *
                                            </label>
                                            <div class="invalid-feedback">Please select a shop.</div>
                                        </div>
                                    </div>

                                    <!-- Product Information Section -->
                                    <div class="col-12">
                                        <h5 class="text-primary fw-bold mb-3 d-flex align-items-center">
                                            <i class="fas fa-box me-2 icon-fallback" data-fallback="📦"></i>
                                            Product Information
                                        </h5>
                                    </div>

                                    <!-- Product Selection -->
                                    <div class="col-12">
                                        <div class="form-floating mb-3">
                                            <select name="product_id"
                                                    class="form-select border-0 shadow-sm"
                                                    id="productSelect"
                                                    required="1"
                                                    style="border-radius: 15px; background: rgba(248, 249, 250, 0.8);">
                                                <option value="" disabled="true" selected="true">Select a product...</option>
                                                <t t-foreach="products" t-as="product">
                                                    <option t-att-value="product.id"><t t-esc="product.display_name"/></option>
                                                </t>
                                            </select>
                                            <label for="productSelect" class="text-muted">
                                                <i class="fas fa-tag me-2 icon-fallback" data-fallback="🏷️"></i>Product *
                                            </label>
                                            <div class="invalid-feedback">Please select a product.</div>
                                        </div>
                                    </div>

                                    <!-- Complaint Details Section -->
                                    <div class="col-12">
                                        <h5 class="text-primary fw-bold mb-3 d-flex align-items-center">
                                            <i class="fas fa-comment-alt me-2 icon-fallback" data-fallback="💬"></i>
                                            Complaint Details
                                        </h5>
                                    </div>

                                    <!-- Description Field -->
                                    <div class="col-12">
                                        <div class="form-floating mb-4">
                                            <textarea name="description"
                                                      class="form-control border-0 shadow-sm"
                                                      id="complaintDescription"
                                                      placeholder="Describe the issue in detail..."
                                                      required="1"
                                                      style="border-radius: 15px; background: rgba(248, 249, 250, 0.8); min-height: 120px; resize: vertical;"></textarea>
                                            <label for="complaintDescription" class="text-muted">
                                                <i class="fas fa-edit me-2 icon-fallback" data-fallback="✏️"></i>Complaint Description *
                                            </label>
                                            <div class="invalid-feedback">Please describe your complaint.</div>
                                        </div>
                                    </div>

                                    <!-- Submit Button -->
                                    <div class="col-12 text-center">
                                        <button type="submit"
                                                class="btn btn-lg px-5 py-3 fw-bold text-white border-0 shadow-lg"
                                                style="background: linear-gradient(45deg, #ff6b6b, #ee5a52); border-radius: 50px; transition: all 0.3s ease; transform: translateY(0);"
                                                onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 25px rgba(238, 90, 82, 0.4)';"
                                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.2)';">
                                            <i class="fas fa-paper-plane me-2 icon-fallback" data-fallback="📤"></i>
                                            Submit Complaint
                                        </button>
                                    </div>

                                    <!-- Help Text -->
                                    <div class="col-12 text-center">
                                        <small class="text-muted">
                                            <i class="fas fa-info-circle me-1 icon-fallback" data-fallback="ℹ️"></i>
                                            All fields marked with * are required. We'll respond within 24-48 hours.
                                        </small>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Footer Info -->
                    <div class="text-center mt-4">
                        <p class="text-white-50 small mb-0">
                            <i class="fas fa-shield-alt me-1 icon-fallback" data-fallback="🛡️"></i>
                            Your information is secure and will only be used to resolve your complaint
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Custom Styles and Scripts -->
        <style>
            /* Mobile-first responsive design */
            @media (max-width: 576px) {
                .container-fluid {
                    padding: 1rem !important;
                }

                .card-body {
                    padding: 1.5rem !important;
                }

                h1 {
                    font-size: 1.75rem !important;
                }

                h5 {
                    font-size: 1.1rem !important;
                }

                .btn-lg {
                    padding: 0.75rem 2rem !important;
                    font-size: 1rem !important;
                }
            }

            @media (min-width: 768px) {
                .form-floating > label {
                    font-size: 0.9rem;
                }
            }

            /* Icon fallback system */
            .icon-fallback {
                position: relative;
            }

            .icon-fallback:before {
                font-family: 'Font Awesome 6 Free', 'Font Awesome 6 Pro', FontAwesome, sans-serif !important;
            }

            /* If Font Awesome fails to load, show emoji fallbacks */
            .icon-fallback:not([class*="fa-"]):after,
            .icon-fallback[class*="fa-"]:before:not(:empty) + .icon-fallback:after {
                content: attr(data-fallback);
                font-family: system-ui, -apple-system, sans-serif;
                font-size: 1em;
                position: absolute;
                left: 0;
                top: 0;
            }

            /* Hide the icon if font awesome doesn't load */
            @supports not (font-family: 'Font Awesome 6 Free') {
                .icon-fallback:before {
                    display: none;
                }
                .icon-fallback:after {
                    content: attr(data-fallback);
                    font-family: system-ui, -apple-system, sans-serif;
                }
            }
            .form-floating > .form-control:focus,
            .form-floating > .form-select:focus {
                border: 2px solid #667eea !important;
                box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25) !important;
            }

            .form-floating > label {
                color: #6c757d !important;
            }

            /* Animation for form sections */
            .card {
                animation: slideUp 0.6s ease-out;
            }

            @keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Icon hover effects */
            .fas {
                transition: all 0.3s ease;
            }

            .form-floating:hover .fas {
                transform: scale(1.1);
                color: #667eea !important;
            }

            /* Loading state for submit button */
            .btn:disabled {
                opacity: 0.7;
                cursor: not-allowed;
            }
        </style>

        <script>
            // Form validation and enhancement
            document.addEventListener('DOMContentLoaded', function() {
                const form = document.querySelector('.needs-validation');
                const submitBtn = form.querySelector('button[type="submit"]');

                // Add Bootstrap validation
                form.addEventListener('submit', function(event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    } else {
                        // Add loading state
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2 icon-fallback" data-fallback="⏳"></i>Submitting...';
                        submitBtn.disabled = true;
                    }
                    form.classList.add('was-validated');
                });

                // Phone number formatting
                const phoneInput = document.getElementById('customerPhone');
                phoneInput.addEventListener('input', function(e) {
                    this.value = this.value.replace(/\D/g, '').slice(0, 10);
                });

                // Auto-resize textarea
                const textarea = document.getElementById('complaintDescription');
                textarea.addEventListener('input', function() {
                    this.style.height = 'auto';
                    this.style.height = Math.max(120, this.scrollHeight) + 'px';
                });
            });
        </script>
    </t>
</template>

<template id="template_complaint_thankyou" name="Complaint Thank You">
    <t t-call="website.layout">
        <!-- Font Awesome CDN -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
        <div class="container-fluid px-3 px-md-4 py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;">
            <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
                <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                    <!-- Success Card -->
                    <div class="card border-0 shadow-lg text-center" style="border-radius: 20px; backdrop-filter: blur(10px);">
                        <div class="card-body p-4 p-md-5">
                            <!-- Success Icon -->
                            <div class="mb-4">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                                     style="width: 100px; height: 100px; background: linear-gradient(45deg, #28a745, #20c997);">
                                    <i class="fas fa-check text-white icon-fallback" style="font-size: 3rem;" data-fallback="✅"></i>
                                </div>
                            </div>

                            <!-- Success Message -->
                            <h2 class="text-success fw-bold mb-3">Thank You!</h2>
                            <p class="fs-5 text-muted mb-4">Your complaint has been successfully registered and is now being processed.</p>

                            <!-- Reference Number -->
                            <div class="bg-light rounded-3 p-4 mb-4" style="border-left: 4px solid #28a745;">
                                <p class="mb-2 text-muted">Your reference number is:</p>
                                <h3 class="text-primary fw-bold mb-0">
                                    <i class="fas fa-hashtag me-1 icon-fallback" data-fallback="#"></i>
                                    <t t-esc="complaint.name"/>
                                </h3>
                            </div>

                            <!-- Additional Info -->
                            <div class="row g-3 text-start">
                                <div class="col-12">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-clock text-primary me-3 icon-fallback" style="width: 20px;" data-fallback="🕐"></i>
                                        <small class="text-muted">We'll respond within 24-48 hours</small>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-envelope text-primary me-3 icon-fallback" style="width: 20px;" data-fallback="✉️"></i>
                                        <small class="text-muted">Updates will be sent to your email</small>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-bookmark text-primary me-3 icon-fallback" style="width: 20px;" data-fallback="🔖"></i>
                                        <small class="text-muted">Save this reference number for tracking</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="mt-4 pt-3 border-top">
                                <div class="row g-2">
                                    <div class="col-12 col-sm-6">
                                        <a href="/" class="btn btn-outline-primary w-100" style="border-radius: 25px;">
                                            <i class="fas fa-home me-2 icon-fallback" data-fallback="🏠"></i>Back to Home
                                        </a>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <a href="/complaint/register" class="btn btn-primary w-100" style="border-radius: 25px; background: linear-gradient(45deg, #667eea, #764ba2);">
                                            <i class="fas fa-plus me-2 icon-fallback" data-fallback="➕"></i>New Complaint
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="text-center mt-4">
                        <p class="text-white-50 small mb-0">
                            <i class="fas fa-heart text-danger me-1 icon-fallback" data-fallback="❤️"></i>
                            Thank you for helping us improve our service
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <style>
            /* Success page animations */
            .card {
                animation: bounceIn 0.8s ease-out;
            }

            @keyframes bounceIn {
                0% {
                    opacity: 0;
                    transform: scale(0.3);
                }
                50% {
                    opacity: 1;
                    transform: scale(1.05);
                }
                70% {
                    transform: scale(0.9);
                }
                100% {
                    opacity: 1;
                    transform: scale(1);
                }
            }

            .fas.fa-check {
                animation: checkMark 1s ease-in-out 0.5s both;
            }

            @keyframes checkMark {
                0% {
                    transform: scale(0);
                }
                50% {
                    transform: scale(1.2);
                }
                100% {
                    transform: scale(1);
                }
            }
        </style>
    </t>
</template>

</odoo>