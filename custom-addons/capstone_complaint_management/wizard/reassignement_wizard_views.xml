<odoo>
    <record id="view_complaint_assignment_reassign_wizard_form" model="ir.ui.view">
        <field name="name">complaint.assignment.reassign.wizard.form</field>
        <field name="model">complaint.assignment.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Reassign Technician">
                <group>
                    <field name="assignment_id"/>
                    <field name="new_technician_id"/>
                    <field name="reason" invisible="1"/>
                </group>
                <footer>
                    <button name="action_reassign"
                            string="Reassign"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
