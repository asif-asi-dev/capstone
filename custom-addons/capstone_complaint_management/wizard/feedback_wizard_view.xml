<odoo>
    <record id="view_complaint_feedback_wizard_form" model="ir.ui.view">
    <field name="name">complaint.feedback.wizard.form</field>
    <field name="model">complaint.feedback.wizard</field>
    <field name="arch" type="xml">
        <form string="Customer Feedback">
            <group>
                <field name="technician_id" readonly="1"/>
                <field name="rating" required="1"/>
                <field name="feedback" widget="text" placeholder="Write customer feedback..." required="1"/>
            </group>
            <footer>
                <button string="Submit Feedback" type="object" name="action_submit_feedback" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>
</odoo>
