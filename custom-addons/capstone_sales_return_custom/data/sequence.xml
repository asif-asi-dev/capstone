<odoo>
    <record id="seq_sales_return_order" model="ir.sequence">
        <field name="name">Sales Return Order Sequence</field>
        <field name="code">sales.return.order</field>
        <field name="prefix">SRO/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_sales_return_request" model="ir.sequence">
        <field name="name">Sales Return Request Sequence</field>
        <field name="code">sale.return.request</field>
        <field name="prefix">SRR/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>