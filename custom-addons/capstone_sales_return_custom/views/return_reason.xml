<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree/List view for Return Reason -->
    <record id="view_return_reason_tree" model="ir.ui.view">
        <field name="name">return.reason.tree</field>
        <field name="model">return.reason</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_inspection_result_tree" model="ir.ui.view">
        <field name="name">inspection.result.tree</field>
        <field name="model">inspection.result</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="location_dest_id" options="{'no_open': True}"/>
            </tree>
        </field>
    </record>

    <!-- Menu Action -->
    <record id="action_return_reason" model="ir.actions.act_window">
        <field name="name">Return Reasons</field>
        <field name="res_model">return.reason</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Menu Action -->
    <record id="action_inspection_result" model="ir.actions.act_window">
        <field name="name">Inspection Results</field>
        <field name="res_model">inspection.result</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
