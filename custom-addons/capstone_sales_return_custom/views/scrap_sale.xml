<odoo>
    <!-- Custom Invoice Form View -->
    <record id="view_move_form_custom_invoice" model="ir.ui.view">
        <field name="name">account.move.form.custom.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Hide product_id column based on parent field -->
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">parent.is_scrap_sale_invoice</attribute>
            </xpath>
            <!-- Restrict UOM dropdown inside tree view -->
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_uom_id']" position="attributes">
                <attribute name="domain">[('category_id', '=', 2)]</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_scrap_sale_invoice" invisible="1"/>
            </xpath>
        </field>
    </record>


    <!-- Custom Action Menu -->
    <record id="action_custom_invoice_scrap_sale" model="ir.actions.act_window">
        <field name="name">Scrap Sale Invoice</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">form,tree</field>
        <field name="view_id" ref="view_move_form_custom_invoice"/>
        <field name="domain">[('move_type','=','out_invoice'),('is_scrap_sale_invoice','=',True)]</field>
        <field name="context">{'default_move_type': 'out_invoice','default_is_scrap_sale_invoice':True}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('account.view_out_invoice_tree')})]"/>
    </record>



</odoo>
