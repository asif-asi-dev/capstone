<odoo>
    <record id="view_sales_return_order_tree" model="ir.ui.view">
        <field name="name">sales.return.order.tree</field>
        <field name="model">sales.return.order</field>
        <field name="arch" type="xml">
            <tree string="Sales Return Orders" create="0">
                <field name="name"/>
                <field name="location_id" options="{'no_open': True}"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_sales_return_order_form" model="ir.ui.view">
        <field name="name">sales.return.order.form</field>
        <field name="model">sales.return.order</field>
        <field name="arch" type="xml">
            <form string="Sales Return Order" create="false">
                <header>
                    <button name="action_process"
                            string="Process"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_inspect"
                            string="Mark as Inspected"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'processing'"/>
                    <button name="action_complete"
                            string="Validate"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'inspected'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_return_pickings"
                                type="object"
                                class="btn btn-secondary o_stat_button"
                                icon="fa-truck"
                                invisible="not picking_ids">
                            <field name="picking_ids"
                                   string="Return Transfer"
                                   widget="statinfo"
                                   options="{'no_open': True}"/>
                        </button>

                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                    <group>
                        <field name="picking_id" readonly="1" invisible="1"/>
                        <field name="partner_id" readonly="1" options="{'no_open': True}"/>
                        <field name="location_id" readonly="1" options="{'no_open': True}"/>
                        <field name="return_request_id" readonly="1" options="{'no_open': True}"/>
                        <field name="allowed_product_ids" invisible="1"/>
                    </group>
                    <group>

                        <field name="picking_ids" invisible="1"/>
                    </group>
                    </group>
                    <notebook>
                        <page string="Return Lines">
                            <field name="line_ids">
                                <tree editable="bottom" >
                                    <field name="product_id" required="1"
                                           domain="[('id', 'in', parent.allowed_product_ids)]"
                                           readonly="parent.state not in ['draft', 'processing']"/>
                                    <field name="invoice_id" readonly="1"/>
                                    <field name="sale_order_id" readonly="1"/>
                                    <field name="quantity" required="1" readonly="1" string="Return Request Quantity" force_save="1"/>
                                    <field name="return_qty" string="Quantity" readonly="parent.state not in ['draft', 'processing']"/>
                                    <field name="uom_id" required="1" readonly="1" options="{'no_open': True}" force_save="1"/>
                                    <field name="return_reason_id" readonly="1" force_save="1"/>
                                    <field name="inspection_result" readonly="parent.state not in ['draft', 'processing']"/>
                                    <field name="lot_id" readonly="parent.state not in ['draft', 'processing']"
                                           invisible="product_id.tracking == 'none'"
                                           domain="[('product_id', '=', product_id)]"/>
                                    <field name="location_dest_id" readonly="parent.state not in ['draft', 'processing']" options="{'no_open': True}" force_save="1"/>
                                    <field name="remarks" readonly="parent.state not in ['draft', 'processing']"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sales_return_order_search" model="ir.ui.view">
        <field name="name">sales.return.order.search</field>
        <field name="model">sales.return.order</field>
        <field name="arch" type="xml">
            <search string="Sales Return Orders Search">
                <field name="name"/>
                <field name="state"/>
                <field name="location_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="State" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_by_location" string="Source Location" domain="[]" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sales_return_order" model="ir.actions.act_window">
        <field name="name">Sales Return Orders</field>
        <field name="res_model">sales.return.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_sales_return_order_tree"/>
        <field name="search_view_id" ref="view_sales_return_order_search"/>
    </record>
</odoo>