<odoo>
    <record id="view_sale_return_request_tree" model="ir.ui.view">
        <field name="name">sale.return.request.tree</field>
        <field name="model">sale.return.request</field>
        <field name="arch" type="xml">
            <tree string="Sales Return Requests">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_return_request_form" model="ir.ui.view">
        <field name="name">sale.return.request.form</field>
        <field name="model">sale.return.request</field>
        <field name="arch" type="xml">
            <form string="Sales Return Request">
                <!-- Header -->
                <header>
                    <button name="action_collect_and_submit_for_approval"
                            string="Collect And Submit For Approval"
                            type="object"
                            invisible="state != 'waiting_for_pickup'"
                            class="oe_highlight"/>
                    <button name="action_submit_for_pickup"
                            string="Submit For Pickup"
                            type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_submit_return_request"
                            string="Approve"
                            type="object"
                            invisible="state != 'submitted'"
                            class="oe_highlight"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state != 'submitted'"
                            class="oe_highlight"/>
                    <button name="action_create_credit_note"
                            string="Create Credit Note"
                            type="object"
                            invisible="state != 'done' or credit_note_id != True"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_return_request_picking"
                                type="object"
                                class="btn btn-secondary o_stat_button"
                                icon="fa-truck"
                                invisible="not return_request_picking_id">
                            <field name="return_request_picking_id"
                                   string="Return Transfer"
                                   widget="statinfo"
                                   options="{'no_open': True}"/>
                        </button>
                        <button name="action_view_return_order"
                                type="object"
                                class="btn btn-secondary o_stat_button"
                                icon="fa-archive"
                                invisible="not return_order_id">
                            <field name="return_order_id"
                                   string="Return Order"
                                   widget="statinfo"
                                   options="{'no_open': True}"/>
                        </button>
                        <button name="action_view_credit_note"
                                type="object"
                                class="btn btn-secondary o_stat_button"
                                icon="fa-credit-card"
                                invisible="not credit_note_id">
                            <field name="credit_note_id"
                                   string="Credit Note"
                                   widget="statinfo"
                                   options="{'no_open': True}"/>
                        </button>
                    </div>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="oe_inline" placeholder="New"/>
                        </h1>
                    </div>

                    <!-- General Info -->
                    <group>
                        <group>
                            <field name="partner_id" required="1"
                                   options="{'no_open': True}"
                                   readonly="state not in ['draft','submitted']"/>
                            <field name="source_location_id" readonly="1" options="{'no_open': True}"/>
                            <field name="destination_location_id" readonly="1" options="{'no_open': True}"/>
                            <field name="notes" readonly="state not in ['draft','submitted']"/>
                            <field name="credit_note_id" readonly="1" invisible="not credit_note_id"/>
                        </group>
                        <group>
                            <field name="date_requested" readonly="1" invisible="date_requested == False"/>
                            <field name="requested_by" readonly="1" invisible="requested_by == False"/>
                            <field name="collected_by" readonly="1" invisible="collected_by == False"/>
                            <field name="collected_date" readonly="1" invisible="collected_date == False"/>
                            <field name="date_approved" readonly="1" invisible="date_approved == False"/>
                            <field name="picking_type_id" invisible="1"/>
                            <field name="return_order_id" invisible="1"/>
                            <field name="return_request_picking_id" invisible="1"/>

                        </group>
                    </group>

                    <!-- Return Lines -->
                    <notebook>
                        <page string="Return Lines">
                            <field name="line_ids" context="{'default_request_id': active_id}"
                                   readonly="state not in ['draft','submitted']">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="invoice_id"
                                           domain="invoice_ids_domain"
                                           string="Invoice"
                                           options="{'no_open': True}"
                                           force_save="1"
                                           readonly="parent.state not in ['draft','submitted']"/>
                                    <field name="sale_order_id" force_save="1" options="{'no_open': True}"
                                           string="Sale Order" domain="[('state','=','sale')]"/>
                                    <field name="invoice_ids_domain" column_invisible="1"/>
                                    <field name="uom_id" readonly="1" options="{'no_open': True}" force_save="1"
                                           string="Uom"/>
                                    <field name="lot_id" options="{'no_open': True}"/>
                                    <field name="product_uom_qty" force_save="1"
                                           readonly="parent.state not in ['draft','submitted'] or sale_order_id"
                                           string="Sale Quantity"/>
                                    <field name="return_available_qty" readonly="1" invisible="0" force_save="1"/>
                                    <field name="return_qty" readonly="parent.state not in ['draft','submitted']"/>
                                    <field name="return_reason_id" readonly="parent.state not in ['draft','submitted']"
                                           options="{'no_open': True,'no_create': True,'no_create_edit': True}"/>
                                    <field name="notes" string="Remarks"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" options="{'no_open': True}" widget="many2many_tags"/>
                                    <field name="total_amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_return_request_line_tree" model="ir.ui.view">
        <field name="name">sale.return.request.line.tree</field>
        <field name="model">sale.return.request.line</field>
        <field name="arch" type="xml">
            <tree string="Sales Return Requests">
                <field name="request_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="return_qty"/>
                <field name="return_reason_id"/>
            </tree>
        </field>
    </record>


    <!-- Action -->
    <record id="action_sale_return_request" model="ir.actions.act_window">
        <field name="name">Sales Return Request</field>
        <field name="res_model">sale.return.request</field>
        <field name="view_mode">tree,form</field>
        <field name="views" eval="[
        (ref('view_sale_return_request_tree'), 'tree'),
        (ref('view_sale_return_request_form'), 'form')
    ]"/>
    </record>

    <record id="action_sale_return_request_line" model="ir.actions.act_window">
        <field name="name">Sales Return Request Lines</field>
        <field name="res_model">sale.return.request.line</field>
        <field name="context">{'delete':0,'duplicate':0,'create':0,'edit':0}
        </field>
        <field name="view_mode">tree</field>
        <field name="views" eval="[
        (ref('view_sale_return_request_line_tree'), 'tree')]"/>
    </record>

</odoo>
