<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form" model="ir.ui.view">
        <field name="name">mrp.bom.form.capstone.manufacture</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']" position="inside">
                <group string="Finished Product Destination" invisible="type != 'normal'">
                    <field name="capstone_produce_to_location"/>
                    <field name="picking_type_id" string="Manufacturing Operation Type"
                           invisible="not capstone_produce_to_location"
                           required="capstone_produce_to_location"/>
                    <field name="capstone_warehouse_root_id" invisible="True"/>
                    <field name="capstone_finished_location_id"
                           invisible="not capstone_produce_to_location"
                           required="capstone_produce_to_location"
                           domain="[('usage', '=', 'internal'), ('id', 'child_of', capstone_warehouse_root_id), ('active', '=', True)]"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
