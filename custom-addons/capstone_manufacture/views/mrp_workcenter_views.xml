<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_form" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.capstone.manufacture</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Employee Access" groups="mrp.group_mrp_manager">
                    <field name="capstone_allowed_employee_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <div class="text-muted">
                        Employees need a linked internal user with Manufacturing User access.
                        An empty list grants no operator access. Manufacturing Administrators
                        retain access to all work centers within their allowed companies.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
