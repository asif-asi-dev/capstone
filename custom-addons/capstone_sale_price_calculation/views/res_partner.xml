<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the base partner form view -->
    <record id="view_partner_form_inherit_margin_discount" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.margin.discount</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page name="price_margins" string="Price Margins">
                    <group>
                        <field name="customer_rank" invisible="1"/>
                    </group>

                    <group string="Customer Pricing Rule" invisible="customer_rank == 0">
                        <field name="margin_percent"/>
                        <field name="discount_percent"/>
                    </group>
                </page>
            </xpath>


        </field>
    </record>
</odoo>
