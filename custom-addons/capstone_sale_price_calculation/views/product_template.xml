<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit product template form view -->
    <record id="view_product_form_inherit_mrp" model="ir.ui.view">
        <field name="name">product.template.form.inherit.mrp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group name="group_customer_margins">
                    <label for="net_rate_based_on"/>
                    <div class="o_row">
                        <field name="net_rate_based_on"/>
                    </div>
                </group>
            </xpath>
<!--            <xpath expr="//group[@name='standard_price']" position="after">-->
<!--                <group name="group_product_mrp" col="2">-->
<!--                    <group>-->
<!--                        <label for="mrp"/>-->
<!--                        <div class="o_row">-->
<!--                            <field name="mrp" class="oe_inline"/>-->
<!--                        </div>-->
<!--                    </group>-->
<!--                </group>-->
<!--            </xpath>-->

            <!-- Insert MRP field before list_price -->
            <xpath expr="//field[@name='categ_id']" position="before">
                <field name="mrp"/>
            </xpath>
            <field name="detailed_type" position="after">
                <field name="mrp"/>
            </field>

        </field>
    </record>
</odoo>
